// PROPOSED DESIGN ONLY. This file does not describe the currently deployed schema.
// Paste the entire file into https://dbdiagram.io/d to draw ALL FOUR databases.
// TripDB and MatchingDB below are diagram namespaces representing SEPARATE databases.
// MatchingDB tables represent MongoDB collections, NOT SQL tables.
// Never use the SQL export of this combined diagram to migrate the application.

Project SwiftRide_System_Proposed {
  Note: '''
    AuthDB and PaymentDB: PostgreSQL. TripDB: SQL Server.
    MatchingDB: MongoDB (collections drawn as tables).
    Target design: 6 Auth tables + 3 Trip tables + 2 Matching collections + 4 Payment tables.
    Auth owns identity, phone, original full name, roles, OTP and tokens.
    Proposed change: driver/vehicle profiles move from Auth to Matching.
    Matching keeps a synchronized display-name copy from Auth.
    Every proposal calculates a fresh fare and preserves its pricing snapshot.
    A rider rejection/timeout cancels the trip; a driver rejection/timeout starts
    a new proposal excluding previously proposed drivers, up to a bounded limit.
    currentProposalId is the proposal ID created by Trip BEFORE matching starts.
    There is no reservations table and no separate reservation ID.
    All timestamps are UTC. No foreign keys span service-owned databases.
  '''
}

Enum TripDB.trip_status {
  Requested
  Matching
  AwaitingRiderApproval
  AwaitingDriverResponse
  DriverAccepted
  EnRoute
  PickedUp
  DroppedOff
  PaymentPending
  Paid
  Cancelled
  Failed
}

Enum TripDB.proposal_status {
  Searching
  AwaitingRiderApproval
  RiderRejected
  RiderTimedOut
  AwaitingDriverResponse
  DriverRejected
  DriverTimedOut
  DriverAccepted
  Cancelled
  NoDriverFound
}

Enum MatchingDB.driver_status {
  Offline
  Available
  Reserved
  Busy
}

Table TripDB.trips {
  id uniqueidentifier [pk, not null]
  rider_id uniqueidentifier [not null, note: 'Auth user ID; logical reference only.']
  accepted_proposal_id uniqueidentifier [null, note: 'Chosen proposal; null until driver acceptance. Must belong to this trip.']
  vehicle_type nvarchar(30) [not null, default: 'Motorbike', note: 'Requested category; initially Motorbike.']
  pickup_address nvarchar(500) [not null]
  pickup_latitude float [not null]
  pickup_longitude float [not null]
  destination_address nvarchar(500) [not null]
  destination_latitude float [not null]
  destination_longitude float [not null]
  status TripDB.trip_status [not null, default: 'Requested']
  picked_up_at datetimeoffset [null]
  dropped_off_at datetimeoffset [null]
  completed_at datetimeoffset [null]
  created_at datetimeoffset [not null]
  updated_at datetimeoffset [not null]

  indexes {
    (rider_id, created_at)
    accepted_proposal_id
    (status, updated_at)
  }

  Note: '''
    No duplicate fare, driver_id or driver_accepted_at columns.
    Read accepted driver, fare, vehicle snapshot and driver response time from
    accepted_proposal_id. History/proposals are retained; no cascading deletion.
    Commit proposal acceptance, trip state and status history atomically.
  '''
}

Table TripDB.trip_proposals {
  id uniqueidentifier [pk, not null, note: 'Trip creates this UUID before requesting a match.']
  trip_id uniqueidentifier [not null]
  driver_id uniqueidentifier [null, note: 'Auth user ID; null while Searching. Never a cross-database FK.']
  status TripDB.proposal_status [not null, default: 'Searching']
  fare_amount decimal(18,2) [null, note: 'Recalculated for EACH new proposal; required before showing the proposal.']
  currency nvarchar(3) [not null, default: 'VND']
  pricing_snapshot nvarchar(max) [null, note: 'JSON: distanceMeters, estimatedDurationSeconds, perKilometer, perMinute, surge, toll, promotionFactor, taxRate. Validate with ISJSON.']
  driver_name_snapshot nvarchar(150) [null]
  plate_number_snapshot nvarchar(20) [null]
  vehicle_name_snapshot nvarchar(150) [null]
  vehicle_image_key_snapshot nvarchar(500) [null]
  rider_approval_expires_at datetimeoffset [null]
  rider_responded_at datetimeoffset [null]
  driver_response_expires_at datetimeoffset [null]
  driver_responded_at datetimeoffset [null, note: 'For DriverAccepted proposals this is the acceptance time.']
  created_at datetimeoffset [not null]
  updated_at datetimeoffset [not null]

  indexes {
    (trip_id, id) [unique, name: 'UQ_proposal_trip_id_id']
    (trip_id, created_at)
    (driver_id, created_at)
    (status, rider_approval_expires_at)
    (status, driver_response_expires_at)
  }

  Note: '''
    Searching rows may omit driver, fare and deadlines. Populate all required
    offer details before AwaitingRiderApproval. Keep each rejected/timed-out
    proposal instead of overwriting it with a different driver.
    Once displayed, do not replace its fare/vehicle snapshot; create a new proposal.
    Accepted proposal fare and snapshot are immutable.
    SQL implementation needs filtered unique indexes: one active proposal per trip,
    one DriverAccepted proposal per trip, and no repeat (trip_id, driver_id)
    for non-null drivers. Those filtered indexes are not encoded as generic DBML.
  '''
}

Table TripDB.trip_status_history {
  id uniqueidentifier [pk, not null]
  trip_id uniqueidentifier [not null]
  from_status TripDB.trip_status [null]
  to_status TripDB.trip_status [not null]
  actor_user_id uniqueidentifier [null, note: 'Auth user ID; null for a system action.']
  created_at datetimeoffset [not null]

  indexes {
    (trip_id, created_at)
  }
}

Ref proposal_belongs_to_trip: TripDB.trip_proposals.trip_id > TripDB.trips.id [delete: no action, update: no action]
Ref history_belongs_to_trip: TripDB.trip_status_history.trip_id > TripDB.trips.id [delete: no action, update: no action]
// Composite FK ensures the chosen proposal actually belongs to this trip.
// Nullable accepted_proposal_id allows inserting the trip BEFORE its proposals.
Ref accepted_proposal_same_trip: TripDB.trips.(id, accepted_proposal_id) > TripDB.trip_proposals.(trip_id, id) [delete: no action, update: no action]

Table MatchingDB.driver_profiles {
  _id varchar(36) [pk, not null, note: 'Mongo string UUID = Auth user ID. One document per driver.']
  legalName varchar(150) [not null, note: 'Driver legal name owned by Matching; independent from the rider display name in Auth.']
  plateNumber varchar(20) [not null, unique, note: 'Normalized plate; one vehicle per driver in this version.']
  vehicleName varchar(150) [not null]
  vehicleType varchar(30) [not null, default: 'Motorbike', note: 'Initially Motorbike; future categories can include Car4Seats/Car7Seats.']
  vehicleImageKey varchar(500) [null, note: 'Object key/path, not image binary.']
  createdAt datetime [not null, note: 'Mongo BSON Date, UTC.']
  updatedAt datetime [not null, note: 'Mongo BSON Date, UTC.']

  Note: 'MongoDB collection, represented as a table ONLY for drawing. Driver identity and vehicle data are owned by Matching.'
}

Table MatchingDB.driver_availability {
  _id varchar(36) [pk, not null, note: 'Same Auth user ID as driver_profiles._id. One document per driver.']
  vehicleType varchar(30) [not null, default: 'Motorbike', note: 'Local copy for filtering; update together with profile changes.']
  status MatchingDB.driver_status [not null, default: 'Offline']
  location json [null, note: 'Embedded GeoJSON: {"type":"Point","coordinates":[longitude,latitude]}. Use MongoDB 2dsphere index.']
  locationUpdatedAt datetime [null, note: 'UTC; stale locations are excluded from matching.']
  currentTripId varchar(36) [null, note: 'Logical TripDB.trips.id; set while Reserved or Busy. No physical FK.']
  currentProposalId varchar(36) [null, note: 'Logical TripDB.trip_proposals.id; set while Reserved. No physical FK.']
  reservedUntil datetime [null, note: 'UTC hold deadline, not a document TTL. Extend when rider accepts.']
  updatedAt datetime [not null]

  indexes {
    (vehicleType, status, locationUpdatedAt)
    (status, reservedUntil)
    currentTripId
    currentProposalId
  }

  Note: '''
    MongoDB collection, represented as a table ONLY for drawing.
    _id logically matches driver_profiles._id; MongoDB does not enforce a FK.
    Available -> Reserved uses one atomic conditional update.
    Check status, trip, proposal and unexpired hold atomically when extending
    or confirming. Expiry worker must conditionally release the same expired hold.
    Reserved requires currentTripId, currentProposalId and reservedUntil.
    Busy keeps currentTripId; clear proposal/hold fields after acceptance.
    Offline/Available clear trip/proposal/hold fields.
    Never TTL-delete this document: a timeout clears the hold, not the driver.
    Release back to Available only when the driver is still online/eligible.
  '''
}

TableGroup TripDB_SQL_Server {
  TripDB.trips
  TripDB.trip_proposals
  TripDB.trip_status_history
}

TableGroup MatchingDB_MongoDB {
  MatchingDB.driver_profiles
  MatchingDB.driver_availability
}


// AuthDB and PaymentDB are separate PostgreSQL databases.
// This is the proposed target: driver_profiles moves OUT of AuthDB into MatchingDB.
// UUID references to users/trips in OTHER databases are logical, never physical FKs.

Enum AuthDB.user_status {
  Active
  Blocked
}

Enum AuthDB.otp_purpose {
  Register
  Login
}

Table AuthDB.users {
  id uuid [pk, not null]
  phone_number varchar(16) [not null, unique, note: 'Vietnamese mobile number normalized to +84 format.']
  full_name varchar(150) [not null]
  status AuthDB.user_status [not null, default: 'Active']
  phone_verified_at timestamptz [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Identity and original full name are owned by Auth. No password: OTP login. Vehicle data belongs to Matching in the proposed design.'
}

Table AuthDB.roles {
  id uuid [pk, not null, note: 'Stable role identity; user_roles references this ID.']
  name varchar(20) [not null, unique, note: 'Unique role name. Seed values: Rider, Driver, Admin.']
}

Table AuthDB.user_roles {
  user_id uuid [not null]
  role_id uuid [not null]

  indexes {
    (user_id, role_id) [pk]
    role_id
  }

  Note: 'One account can have Rider AND Driver. Public registration grants Rider only.'
}

Table AuthDB.otp_challenges {
  id uuid [pk, not null]
  phone_number varchar(16) [not null]
  purpose AuthDB.otp_purpose [not null]
  client_app varchar(20) [not null, note: 'App checked at OTP request; verification must match; determines session role scope. Registration is RiderApp.']
  registration_full_name varchar(150) [null, note: 'Pending registration name; no user exists yet. Null for login.']
  code_hash varchar(64) [not null, note: 'HMAC-SHA256 bound to challenge, phone and purpose. Never plaintext OTP.']
  request_ip varchar(64) [not null, note: 'OTP request rate-limit accounting.']
  attempt_count integer [not null, default: 0]
  created_at timestamptz [not null]
  expires_at timestamptz [not null]
  consumed_at timestamptz [null]
  invalidated_at timestamptz [null]

  indexes {
    (phone_number, created_at)
    (request_ip, phone_number, created_at)
  }

  Note: '''
    No FK to users: registration may target a not-yet-created user.
    Development-only fixed OTP 123456, not returned in responses.
    Default lifetime 5 minutes, at most 5 incorrect attempts, resend after 60 seconds.
    New challenge invalidates the previous one with the same phone and purpose.
    Never create a user before successful registration OTP verification.
  '''
}

Table AuthDB.auth_sessions {
  id uuid [pk, not null, note: 'SessionId / sid; one session per successful login.']
  user_id uuid [not null]
  client_app varchar(20) [not null, note: 'From OTP challenge. JWT and refresh restricted to the corresponding current user role.']
  device_name varchar(200) [null]
  created_at timestamptz [not null]
  expires_at timestamptz [not null, note: 'Absolute session deadline; default 30 days, not extended by refresh.']
  revoked_at timestamptz [null]
  revocation_reason varchar(50) [null, note: 'For example Logout, RefreshTokenReuse or UserBlocked.']

  indexes {
    (user_id, expires_at)
  }
}

Table AuthDB.refresh_tokens {
  id uuid [pk, not null]
  session_id uuid [not null]
  token_hash varchar(64) [not null, unique, note: 'SHA-256 of the random refresh token; raw token goes only to the client.']
  created_at timestamptz [not null]
  expires_at timestamptz [not null]
  used_at timestamptz [null]
  replaced_by_token_id uuid [null, note: 'Next refresh token generation in the SAME session.']

  indexes {
    (session_id, id) [unique, name: 'UQ_refresh_token_session_id_id']
    (session_id, replaced_by_token_id)
  }

  Note: '''
    Refresh creates a replacement and marks its predecessor used in one transaction.
    Reusing any used generation revokes the whole session, including its newest token.
    Retain used token records until the session has expired for reuse detection.
    Access JWTs are not stored in the database; existing access JWTs expire naturally.
  '''
}

Ref auth_user_role_user: AuthDB.user_roles.user_id > AuthDB.users.id [delete: cascade, update: no action]
Ref auth_user_role_role: AuthDB.user_roles.role_id > AuthDB.roles.id [delete: no action, update: no action]
Ref auth_session_user: AuthDB.auth_sessions.user_id > AuthDB.users.id [delete: no action, update: no action]
Ref auth_refresh_session: AuthDB.refresh_tokens.session_id > AuthDB.auth_sessions.id [delete: no action, update: no action]
Ref auth_refresh_replacement_same_session: AuthDB.refresh_tokens.(session_id, replaced_by_token_id) > AuthDB.refresh_tokens.(session_id, id) [delete: no action, update: no action]

Enum PaymentDB.payment_status {
  Pending
  Processing
  Succeeded
  Failed
}

Enum PaymentDB.entry_side {
  Debit
  Credit
}

Table PaymentDB.payments {
  id uuid [pk, not null]
  trip_id uuid [not null, unique, note: 'Logical TripDB.trips.id; one payment per trip in the current scope. No cross-database FK.']
  rider_id uuid [not null, note: 'Logical Auth user ID of payer; supplied by trusted Trip backend.']
  driver_id uuid [not null, note: 'Logical Auth user ID of beneficiary; supplied by Trip from its accepted proposal.']
  amount numeric(18,2) [not null, note: 'Nonnegative; supplied from the accepted proposal, never trusted from app input.']
  currency varchar(3) [not null, default: 'VND']
  status PaymentDB.payment_status [not null, default: 'Pending']
  idempotency_key varchar(100) [not null, unique]
  provider_reference varchar(200) [null]
  failure_code varchar(100) [null]
  paid_at timestamptz [null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (rider_id, created_at)
    (driver_id, created_at)
  }

  Note: 'Retries reuse the same operation identity. Payment stores its own agreed amount for financial history; do not look up a mutable price from another service. No card number/CVV storage.'
}

Table PaymentDB.ledger_accounts {
  id uuid [pk, not null]
  code varchar(50) [not null, note: 'Accounting category, for example PAYMENT_CLEARING, DRIVER_PAYABLE or PLATFORM_REVENUE.']
  owner_user_id uuid [null, note: 'Logical Auth user ID for driver accounts; null for platform-wide accounts.']
  currency varchar(3) [not null, default: 'VND']
  created_at timestamptz [not null]

  indexes {
    (code, owner_user_id, currency) [unique, name: 'UQ_ledger_account_owner_currency']
  }

  Note: 'These are accounting accounts, not login accounts. PostgreSQL uniqueness uses NULLS NOT DISTINCT for owner_user_id; generic DBML does not express that option.'
}

Table PaymentDB.ledger_transactions {
  id uuid [pk, not null]
  payment_id uuid [not null]
  type varchar(50) [not null, note: 'Operation grouping, for example PaymentReceived; future Refund/Adjustment.']
  idempotency_key varchar(100) [not null, unique]
  created_at timestamptz [not null]

  Note: 'One payment can have several separately balanced operations. Refunds/payouts are not implemented in the initial scope.'
}

Table PaymentDB.ledger_entries {
  id uuid [pk, not null]
  transaction_id uuid [not null]
  account_id uuid [not null]
  side PaymentDB.entry_side [not null]
  amount numeric(18,2) [not null, note: 'Strictly positive. Account currency must match the payment/transaction currency.']

  indexes {
    transaction_id
    account_id
  }

  Note: 'Every ledger transaction must balance total Debit = total Credit. Future posting workflow must validate and commit all lines plus payment state atomically; schema alone does not enforce cross-row balance.'
}

Ref ledger_transaction_payment: PaymentDB.ledger_transactions.payment_id > PaymentDB.payments.id [delete: no action, update: no action]
Ref ledger_entry_transaction: PaymentDB.ledger_entries.transaction_id > PaymentDB.ledger_transactions.id [delete: no action, update: no action]
Ref ledger_entry_account: PaymentDB.ledger_entries.account_id > PaymentDB.ledger_accounts.id [delete: no action, update: no action]

TableGroup AuthDB_PostgreSQL {
  AuthDB.users
  AuthDB.roles
  AuthDB.user_roles
  AuthDB.otp_challenges
  AuthDB.auth_sessions
  AuthDB.refresh_tokens
}

TableGroup PaymentDB_PostgreSQL {
  PaymentDB.payments
  PaymentDB.ledger_accounts
  PaymentDB.ledger_transactions
  PaymentDB.ledger_entries
}
