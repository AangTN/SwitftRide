{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "Issuer": "swiftride-auth",
    "Audience": "swiftride-api"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-register-request-otp": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "Order": -10,
        "Match": {
          "Path": "/api/auth/register/request-otp"
        },
        "Transforms": [
          {
            "X-Forwarded": "Set"
          }
        ]
      },
      "auth-register-verify-otp": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "Order": -10,
        "Match": {
          "Path": "/api/auth/register/verify-otp"
        },
        "Transforms": [
          {
            "X-Forwarded": "Set"
          }
        ]
      },
      "auth-login-request-otp": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "Order": -10,
        "Match": {
          "Path": "/api/auth/login/request-otp"
        },
        "Transforms": [
          {
            "X-Forwarded": "Set"
          }
        ]
      },
      "auth-login-verify-otp": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "Order": -10,
        "Match": {
          "Path": "/api/auth/login/verify-otp"
        },
        "Transforms": [
          {
            "X-Forwarded": "Set"
          }
        ]
      },
      "auth-refresh": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "Order": -10,
        "Match": {
          "Path": "/api/auth/refresh"
        },
        "Transforms": [
          {
            "X-Forwarded": "Set"
          }
        ]
      },
      "auth": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        },
        "Transforms": [
          {
            "X-Forwarded": "Set"
          }
        ]
      },
      "trip": {
        "ClusterId": "trip",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/trips/{**remainder}"
        },
        "Transforms": [
          {
            "X-Forwarded": "Set"
          }
        ]
      },
      "matching": {
        "ClusterId": "matching",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/matching/{**remainder}"
        },
        "Transforms": [
          {
            "X-Forwarded": "Set"
          }
        ]
      },
      "payment": {
        "ClusterId": "payment",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/payments/{**remainder}"
        },
        "Transforms": [
          {
            "X-Forwarded": "Set"
          }
        ]
      },
      "seed-image": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/seed/{**remainder}"
        }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5101/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:15"
        }
      },
      "trip": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5102/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:15"
        }
      },
      "matching": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5103/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:15"
        }
      },
      "payment": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5104/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:15"
        }
      }
    }
  }
}